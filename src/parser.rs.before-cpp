#![forbid(unsafe_code)]

use crate::errors::KonaError;
use crate::types::K;
use crate::types::KData;
use std::sync::Arc;

pub const SYSTEM_VERBS: &[&str] = &[
    "_gdown", "_gfree", "_grun", "_gup", "_gk", // GPU (gpu.rs) - longer names first, like the rest
    "_ceiling", "_getenv", "_setenv", "_floor", "_gtime", "_ltime", "_solve", "_trans", "_acos",
    "_asin", "_atan", "_binl", "_cosh", "_draw", "_hash", "_host", "_sinh", "_size", "_sqrt",
    "_tanh", "_abs", "_bin", "_cos", "_div", "_dot", "_exp", "_hat", "_inv", "_log", "_lsq",
    "_mul", "_sin", "_sqr", "_ssr", "_sv", "_tan", "_val", "_vsx", "_exit", "_conj", "_real",
    "_imag", "_ci", "_ic", "_ss", "_vs", "_sm", "_di", "_dvl", "_dv", "_lin", "_jd", "_dj", "_lt",
    "_bd", "_db", "_ceil", "_in",
];

#[derive(Clone, Debug, PartialEq)]
pub enum Word {
    Noun(K),
    Name(String),
    Verb(String),
    Adverb(String),
    Paren(Vec<Vec<Word>>),   // expressions separated by semicolons
    Bracket(Vec<Vec<Word>>), // expressions separated by semicolons
    Brace {
        body: String,
        args: Vec<String>,
        code: Vec<Word>,
    },
    LocalAssign(String),
    GlobalAssign(String),
}

#[derive(Clone, Debug, PartialEq)]
enum TokenKind {
    Noun(K),
    Name(String),
    Verb(String),
    Adverb(String),
    LocalAssign(String),
    GlobalAssign(String),
    OpenParen,
    CloseParen,
    OpenBracket,
    CloseBracket,
    OpenBrace,
    CloseBrace,
    Semicolon,
}

#[derive(Clone, Debug)]
struct Token {
    kind: TokenKind,
    start: usize,
    end: usize,
}

#[derive(Clone, Copy, Debug)]
enum NumberVal {
    Int(i64),
    Float(f64),
}

fn parse_single_number(spec_str: &str, is_negative: bool) -> Option<(NumberVal, usize)> {
    let check_str = if is_negative {
        &spec_str[1..]
    } else {
        spec_str
    };
    if check_str.starts_with("0I") {
        let len = if is_negative { 3 } else { 2 };
        let val = if is_negative { -i64::MAX } else { i64::MAX };
        return Some((NumberVal::Int(val), len));
    }
    if check_str.starts_with("0i") {
        let len = if is_negative { 3 } else { 2 };
        let val = if is_negative {
            f64::NEG_INFINITY
        } else {
            f64::INFINITY
        };
        return Some((NumberVal::Float(val), len));
    }
    if check_str.starts_with("0N") {
        let len = if is_negative { 3 } else { 2 };
        return Some((NumberVal::Int(i64::MIN), len));
    }
    if check_str.starts_with("0n") {
        let len = if is_negative { 3 } else { 2 };
        return Some((NumberVal::Float(f64::NAN), len));
    }

    let mut chars = spec_str.chars().peekable();
    let mut consumed = 0;
    if is_negative {
        chars.next();
        consumed += 1;
    }

    let mut has_dot = false;
    let mut num_str = String::new();
    if is_negative {
        num_str.push('-');
    }

    let first = chars.peek()?;
    if *first == '.' {
        // Must be followed by digit to be a float
        chars.next();
        consumed += 1;
        let second = chars.peek();
        if let Some('0'..='9') = second {
            has_dot = true;
            num_str.push('.');
            while let Some('0'..='9') = chars.peek() {
                num_str.push(chars.next().unwrap());
                consumed += 1;
            }
        } else {
            return None;
        }
    } else if first.is_ascii_digit() {
        while let Some('0'..='9') = chars.peek() {
            num_str.push(chars.next().unwrap());
            consumed += 1;
        }
        if let Some('.') = chars.peek() {
            // Accept trailing dot as float literal (e.g. "2." == 2.0) to match C Kona tokenization
            // for numeric cases in find/group/hash. Followed by digits optional.
            has_dot = true;
            num_str.push(chars.next().unwrap());
            consumed += 1;
            while let Some('0'..='9') = chars.peek() {
                num_str.push(chars.next().unwrap());
                consumed += 1;
            }
        }
    } else {
        return None;
    }

    let mut chars_clone = chars.clone();
    if let Some('e' | 'E') = chars_clone.next() {
        let mut exp_len = 1;
        if let Some('-') = chars_clone.peek() {
            chars_clone.next();
            exp_len += 1;
        }
        let mut digit_count = 0;
        while let Some('0'..='9') = chars_clone.peek() {
            chars_clone.next();
            digit_count += 1;
            exp_len += 1;
        }
        if digit_count > 0 {
            for _ in 0..exp_len {
                num_str.push(chars.next().unwrap());
                consumed += 1;
            }
            has_dot = true;
        }
    }

    let val = if has_dot {
        let f = num_str.parse::<f64>().ok()?;
        NumberVal::Float(f)
    } else {
        let i = num_str.parse::<i64>().ok()?;
        NumberVal::Int(i)
    };
    if consumed < spec_str.len() {
        let next_char = spec_str[consumed..].chars().next().unwrap();
        if next_char.is_ascii_alphabetic() {
            return None;
        }
        if next_char == '_' {
            let mut suffix_chars = spec_str[consumed + 1..].chars();
            if let Some(after_underscore) = suffix_chars.next() {
                if after_underscore.is_ascii_alphabetic() {
                    // `100_vs` lexes as number + system verb (C Kona resolves
                    // `_word` against the verb table, even when a variable of
                    // that name exists); `2_x` is a parse error there too.
                    let rest = &spec_str[consumed..];
                    if !SYSTEM_VERBS.iter().any(|v| rest.starts_with(v)) {
                        return None;
                    }
                }
            }
        }
    }
    Some((val, consumed))
}

fn parse_number_vector(
    s: &str,
    start_index: usize,
    first_val: NumberVal,
    first_consumed: usize,
) -> (KData, usize) {
    let mut vals = vec![first_val];
    let mut consumed = start_index + first_consumed;

    loop {
        let mut temp_consumed = consumed;
        let mut has_spaces = false;
        let bytes = s.as_bytes();
        while temp_consumed < bytes.len() {
            let b = bytes[temp_consumed];
            if b == b' ' || b == b'\t' {
                has_spaces = true;
                temp_consumed += 1;
            } else {
                break;
            }
        }

        if !has_spaces || temp_consumed >= bytes.len() {
            break;
        }

        let is_neg = if bytes[temp_consumed] == b'-' {
            let next_b = bytes.get(temp_consumed + 1).map(|&b| b as char);
            matches!(next_b, Some('0'..='9') | Some('.'))
        } else {
            false
        };

        if let Some((next_val, next_consumed)) = parse_single_number(&s[temp_consumed..], is_neg) {
            vals.push(next_val);
            consumed = temp_consumed + next_consumed;
        } else {
            break;
        }
    }

    let total_consumed = consumed - start_index;

    let kdata = if vals.len() == 1 {
        match vals[0] {
            NumberVal::Int(i) => KData::IntAtom(i),
            NumberVal::Float(f) => KData::FloatAtom(f),
        }
    } else {
        let has_float = vals.iter().any(|v| matches!(v, NumberVal::Float(_)));
        if has_float {
            let float_vec: Vec<f64> = vals
                .iter()
                .map(|v| match v {
                    NumberVal::Int(i) => crate::types::i2f(*i),
                    NumberVal::Float(f) => *f,
                })
                .collect();
            KData::FloatList(float_vec)
        } else {
            let int_vec: Vec<i64> = vals
                .iter()
                .map(|v| match v {
                    NumberVal::Int(i) => *i,
                    NumberVal::Float(_) => unreachable!(),
                })
                .collect();
            KData::IntList(int_vec)
        }
    };

    (kdata, total_consumed)
}

fn parse_string_to_bytes(s: &str) -> Result<Option<(Vec<u8>, usize)>, KonaError> {
    if !s.starts_with('"') {
        return Ok(None);
    }
    let mut chars = s.char_indices().skip(1).peekable();
    let mut bytes = Vec::new();

    while let Some((idx, c)) = chars.next() {
        if c == '"' {
            return Ok(Some((bytes, idx + c.len_utf8())));
        } else if c == '\\' {
            if let Some((_, next_c)) = chars.next() {
                match next_c {
                    'n' => bytes.push(b'\n'),
                    't' => bytes.push(b'\t'),
                    'r' => bytes.push(b'\r'),
                    'b' => bytes.push(b'\x08'),
                    'f' => bytes.push(b'\x0c'),
                    'v' => bytes.push(b'\x0b'),
                    'a' => bytes.push(b'\x07'),
                    '"' => bytes.push(b'"'),
                    '\\' => bytes.push(b'\\'),
                    '0'..='7' => {
                        let mut octal_str = String::new();
                        octal_str.push(next_c);
                        for _ in 0..2 {
                            if let Some(&(_, peek_c)) = chars.peek() {
                                if peek_c.is_digit(8) {
                                    octal_str.push(peek_c);
                                    chars.next();
                                } else {
                                    break;
                                }
                            } else {
                                break;
                            }
                        }
                        if let Ok(val) = u32::from_str_radix(&octal_str, 8) {
                            if val > 255 {
                                return Err(KonaError::Parse(
                                    "Octal escape exceeds 255".to_string(),
                                ));
                            }
                            bytes.push(val as u8);
                        }
                    }
                    _ => {
                        bytes.push(b'\\');
                        let mut buf = [0; 4];
                        for &b in next_c.encode_utf8(&mut buf).as_bytes() {
                            bytes.push(b);
                        }
                    }
                }
            } else {
                return Ok(None);
            }
        } else {
            let mut buf = [0; 4];
            for &b in c.encode_utf8(&mut buf).as_bytes() {
                bytes.push(b);
            }
        }
    }
    Ok(None)
}

fn parse_symbols(s: &str) -> Result<Option<(KData, usize)>, KonaError> {
    if !s.starts_with('`') {
        return Ok(None);
    }

    let mut symbols: Vec<Arc<str>> = Vec::new();
    let mut consumed = 0;

    let bytes = s.as_bytes();
    while consumed < bytes.len() && bytes[consumed] == b'`' {
        consumed += 1;

        if consumed < bytes.len() && bytes[consumed] == b'"' {
            if let Some((str_bytes, str_consumed)) = parse_string_to_bytes(&s[consumed..])? {
                if let Ok(utf8_str) = String::from_utf8(str_bytes) {
                    symbols.push(Arc::from(utf8_str.as_str()));
                    consumed += str_consumed;
                } else {
                    return Ok(None);
                }
            } else {
                return Ok(None);
            }
        } else {
            let mut sym_str = String::new();
            while consumed < bytes.len()
                && (bytes[consumed].is_ascii_alphanumeric() || bytes[consumed] == b'_')
            {
                if (b'0'..=b'6').contains(&bytes[consumed])
                    && consumed + 1 < bytes.len()
                    && bytes[consumed + 1] == b':'
                {
                    break;
                }
                sym_str.push(bytes[consumed] as char);
                consumed += 1;
            }
            symbols.push(Arc::from(sym_str.as_str()));
        }
    }

    if symbols.is_empty() {
        Ok(None)
    } else if symbols.len() == 1 {
        Ok(Some((KData::SymbolAtom(symbols[0].clone()), consumed)))
    } else {
        Ok(Some((KData::SymbolList(symbols), consumed)))
    }
}

fn is_system_verb(s: &str) -> bool {
    SYSTEM_VERBS.contains(&s)
}

fn is_primitive_verb_char(c: char) -> bool {
    matches!(
        c,
        '+' | '-'
            | '*'
            | '%'
            | '&'
            | '|'
            | '<'
            | '>'
            | '='
            | '~'
            | ','
            | '#'
            | '^'
            | '!'
            | '_'
            | '?'
            | '@'
            | '.'
            | ':'
            | '$'
    )
}

fn validate_function_tokens(tokens: &[Token]) -> Result<(), KonaError> {
    for tok in tokens {
        if let TokenKind::Name(name) = &tok.kind {
            if name.starts_with("_vs.") || name.starts_with("_vs_") {
                return Err(KonaError::Parse("Malformed system verb name".to_string()));
            }
            if name.starts_with('_') && name.len() > 2 && !is_system_verb(name) {
                return Err(KonaError::Parse("reserved".to_string()));
            }
        }
    }
    Ok(())
}

fn parse_adverb(s: &str) -> Option<(Word, usize)> {
    if s.starts_with("':") || s.starts_with("/:") || s.starts_with("\\:") {
        Some((Word::Adverb(s[..2].to_string()), 2))
    } else if s.starts_with('\'') || s.starts_with('/') || s.starts_with('\\') {
        Some((Word::Adverb(s[..1].to_string()), 1))
    } else {
        None
    }
}

fn match_k_name(s: &str) -> Option<usize> {
    let bytes = s.as_bytes();
    if bytes.is_empty() {
        return None;
    }
    let n = bytes.len();
    let mut c = 0;
    if c < n && bytes[c] == b'.' {
        if c + 1 < n && bytes[c + 1].is_ascii_alphabetic() {
            c += 2;
        } else {
            return None;
        }
    } else if c < n && bytes[c].is_ascii_alphabetic() {
        c += 1;
    } else {
        return None;
    }

    while c < n && (bytes[c].is_ascii_alphanumeric() || bytes[c] == b'_') {
        c += 1;
    }

    loop {
        if c >= n {
            break;
        }
        if bytes[c] == b'.' {
            if c + 1 == n {
                c += 1;
                break;
            }
            c += 1;
            if c < n && bytes[c].is_ascii_alphabetic() {
                c += 1;
                while c < n && (bytes[c].is_ascii_alphanumeric() || bytes[c] == b'_') {
                    c += 1;
                }
            } else {
                break;
            }
        } else {
            break;
        }
    }

    if c > 0 { Some(c) } else { None }
}

fn parse_name_or_system_verb_token(s: &str) -> Option<(Word, usize)> {
    let bytes = s.as_bytes();
    if bytes.is_empty() {
        return None;
    }

    let first = bytes[0];
    if !(first.is_ascii_alphabetic() || first == b'.' || first == b'_') {
        return None;
    }

    if s.len() == 1 {
        if first == b'.' {
            return Some((Word::Verb(".".to_string()), 1));
        }
        if first == b'_' {
            return Some((Word::Verb("_".to_string()), 1));
        }
    }

    if first == b'.' && s.len() > 1 && bytes[1].is_ascii_digit() {
        return None;
    }

    if first == b'_' {
        let mut l = 1;
        while l < bytes.len()
            && (bytes[l].is_ascii_alphanumeric() || bytes[l] == b'_' || bytes[l] == b'.')
        {
            l += 1;
        }
        let word_str = &s[..l];
        if is_system_verb(word_str) {
            return Some((Word::Verb(word_str.to_string()), l));
        }
        let is_valid_var = l == 2 && bytes[1].is_ascii_alphabetic();
        if is_valid_var {
            return Some((Word::Name(word_str.to_string()), l));
        }
        return None;
    }

    let len = match match_k_name(s) {
        Some(l) => l,
        None => return None,
    };

    if len == 0 {
        return None;
    }

    let name_str = &s[..len];

    if name_str == "if" || name_str == "while" || name_str == "do" {
        return Some((Word::Name(name_str.to_string()), len));
    }

    if name_str == "." {
        return Some((Word::Verb(".".to_string()), 1));
    }
    if name_str == "_" {
        return Some((Word::Verb("_".to_string()), 1));
    }

    let mut colon_idx = len;
    while colon_idx < bytes.len() && (bytes[colon_idx] == b' ' || bytes[colon_idx] == b'\t') {
        colon_idx += 1;
    }
    if colon_idx < bytes.len() && bytes[colon_idx] == b':' {
        if colon_idx + 1 < bytes.len() && bytes[colon_idx + 1] == b':' {
            return Some((Word::GlobalAssign(name_str.to_string()), colon_idx + 2));
        } else {
            return Some((Word::LocalAssign(name_str.to_string()), colon_idx + 1));
        }
    }

    Some((Word::Name(name_str.to_string()), len))
}

fn tokenize_system_id(id: &str) -> Result<Vec<TokenKind>, KonaError> {
    let mut tokens = Vec::new();
    let mut s = id;
    while !s.is_empty() {
        let mut matched_verb = None;
        for &verb in SYSTEM_VERBS {
            if s.starts_with(verb) {
                if matched_verb.map_or(true, |v: &str| verb.len() > v.len()) {
                    matched_verb = Some(verb);
                }
            }
        }
        if let Some(verb) = matched_verb {
            tokens.push(TokenKind::Verb(verb.to_string()));
            s = &s[verb.len()..];
            continue;
        }

        let bytes = s.as_bytes();
        if bytes.len() >= 2 && bytes[0] == b'_' && bytes[1].is_ascii_alphabetic() {
            let var_name = &s[..2];
            if s.len() == id.len() {
                if bytes.len() == 2 {
                    tokens.push(TokenKind::Name(var_name.to_string()));
                    s = &s[2..];
                    continue;
                } else if bytes[2] == b'_' {
                    let rest = &s[2..];
                    let mut rest_is_verb = false;
                    for &verb in SYSTEM_VERBS {
                        if rest.starts_with(verb) {
                            rest_is_verb = true;
                            break;
                        }
                    }
                    if rest_is_verb {
                        tokens.push(TokenKind::Name(var_name.to_string()));
                        s = &s[2..];
                        continue;
                    }
                }
            }
        }

        let mut starts_with_verb = false;
        for &verb in SYSTEM_VERBS {
            if id.starts_with(verb) {
                starts_with_verb = true;
                break;
            }
        }
        if starts_with_verb {
            return Err(KonaError::Parse("parse".to_string()));
        } else {
            return Err(KonaError::Parse("reserved".to_string()));
        }
    }
    Ok(tokens)
}

fn has_invalid_colon_suffix(input: &str) -> bool {
    let trimmed = input.trim_end();
    let trailing = trimmed
        .as_bytes()
        .iter()
        .rev()
        .take_while(|&&b| b == b':')
        .count();

    if trailing == 0 {
        return false;
    }

    if trailing > 1 {
        return trailing % 2 == 1;
    }

    let prefix = trimmed[..trimmed.len() - 1].trim_end();
    if prefix.is_empty() {
        return false;
    }

    !matches!(
        prefix.as_bytes().last().copied(),
        Some(b'/') | Some(b'\\') | Some(b'\'') | Some(b'0'..=b'6')
    )
}

fn tokenize(input: &str) -> Result<Vec<Token>, KonaError> {
    let mut tokens = Vec::new();
    let mut i = 0;
    let bytes = input.as_bytes();

    while i < bytes.len() {
        let c = bytes[i] as char;

        if c == '_' && i + 1 < bytes.len() && (bytes[i + 1] as char).is_ascii_alphabetic() {
            let mut len = 1;
            while i + len < bytes.len() {
                let next_c = bytes[i + len] as char;
                if next_c.is_ascii_alphabetic() || next_c == '_' || next_c == '.' {
                    len += 1;
                } else {
                    break;
                }
            }
            let id = &input[i..i + len];
            let sys_tokens = tokenize_system_id(id)?;
            let mut cur_offset = 0;
            for t_kind in sys_tokens {
                let tok_len = match &t_kind {
                    TokenKind::Verb(v) => v.len(),
                    TokenKind::Name(n) => n.len(),
                    _ => unreachable!(),
                };
                tokens.push(Token {
                    kind: t_kind,
                    start: i + cur_offset,
                    end: i + cur_offset + tok_len,
                });
                cur_offset += tok_len;
            }
            i += len;
            continue;
        }

        if c == '\n' || c == '\r' {
            tokens.push(Token {
                kind: TokenKind::Semicolon,
                start: i,
                end: i + 1,
            });
            if c == '\r' && i + 1 < bytes.len() && bytes[i + 1] == b'\n' {
                i += 1;
            }
            i += 1;
            continue;
        }

        if c == ' ' || c == '\t' {
            i += 1;
            continue;
        }

        if c == '/' {
            // If it's `/:`, it is an adverb, not a comment
            if i + 1 < bytes.len() && bytes[i + 1] == b':' {
                // Do not treat as comment, let adverb parsing handle it
            } else {
                // Check if comment
                let mut is_comment = false;
                if i == 0 {
                    is_comment = true;
                } else if bytes[i - 1] == b' '
                    || bytes[i - 1] == b'\t'
                    || bytes[i - 1] == b'\n'
                    || bytes[i - 1] == b';'
                {
                    is_comment = true;
                }
                if is_comment {
                    while i < bytes.len() && bytes[i] != b'\n' && bytes[i] != b'\r' {
                        i += 1;
                    }
                    continue;
                }
            }
        }

        if i + 1 < bytes.len() {
            let first = bytes[i];
            let second = bytes[i + 1];
            if (b'0'..=b'6').contains(&first) && second == b':' {
                let verb_str = format!("{}:", first as char);
                tokens.push(Token {
                    kind: TokenKind::Verb(verb_str),
                    start: i,
                    end: i + 2,
                });
                i += 2;
                continue;
            }
        }

        if c == ':' {
            let mut run_len = 1;
            while i + run_len < bytes.len() && bytes[i + run_len] == b':' {
                run_len += 1;
            }
            if run_len > 1 {
                if run_len % 2 == 1 {
                    return Err(KonaError::Parse("parse".to_string()));
                }
                tokens.push(Token {
                    kind: TokenKind::Verb(":".repeat(run_len)),
                    start: i,
                    end: i + run_len,
                });
                i += run_len;
                continue;
            }
        }

        // Float or Int literal
        let mut is_number = false;
        if c.is_ascii_digit() {
            is_number = true;
        } else if c == '-' {
            // Negative number literal or minus verb
            if i + 1 < bytes.len() {
                let next = bytes[i + 1] as char;
                if next.is_ascii_digit() || next == '.' {
                    // Check if preceded by a noun/name or close paren/bracket/brace (infix minus)
                    let infix = if let Some(last_tok) = tokens.last() {
                        matches!(
                            last_tok.kind,
                            TokenKind::Noun(_)
                                | TokenKind::Name(_)
                                | TokenKind::CloseParen
                                | TokenKind::CloseBracket
                                | TokenKind::CloseBrace
                        )
                    } else {
                        false
                    };
                    if !infix {
                        is_number = true;
                    }
                }
            }
        } else if c == '.' {
            // Float literal starting with dot
            if i + 1 < bytes.len() && (bytes[i + 1] as char).is_ascii_digit() {
                // Must not be preceded by alphanumeric/underscore
                let preceded =
                    i > 0 && (bytes[i - 1].is_ascii_alphanumeric() || bytes[i - 1] == b'_');
                if !preceded {
                    is_number = true;
                }
            }
        }

        if is_number {
            if let Some((num_val, consumed)) = parse_single_number(&input[i..], c == '-') {
                let (kdata, total_consumed) = parse_number_vector(input, i, num_val, consumed);
                tokens.push(Token {
                    kind: TokenKind::Noun(K::from(kdata)),
                    start: i,
                    end: i + total_consumed,
                });
                i += total_consumed;
                continue;
            }
        }

        if c == '(' {
            tokens.push(Token {
                kind: TokenKind::OpenParen,
                start: i,
                end: i + 1,
            });
            i += 1;
            continue;
        }
        if c == ')' {
            tokens.push(Token {
                kind: TokenKind::CloseParen,
                start: i,
                end: i + 1,
            });
            i += 1;
            continue;
        }
        if c == '[' {
            tokens.push(Token {
                kind: TokenKind::OpenBracket,
                start: i,
                end: i + 1,
            });
            i += 1;
            continue;
        }
        if c == ']' {
            tokens.push(Token {
                kind: TokenKind::CloseBracket,
                start: i,
                end: i + 1,
            });
            i += 1;
            continue;
        }
        if c == '{' {
            tokens.push(Token {
                kind: TokenKind::OpenBrace,
                start: i,
                end: i + 1,
            });
            i += 1;
            continue;
        }
        if c == '}' {
            tokens.push(Token {
                kind: TokenKind::CloseBrace,
                start: i,
                end: i + 1,
            });
            i += 1;
            continue;
        }
        if c == ';' {
            tokens.push(Token {
                kind: TokenKind::Semicolon,
                start: i,
                end: i + 1,
            });
            i += 1;
            continue;
        }

        if c == '\\' && i + 1 < bytes.len() && bytes[i + 1] == b'\\' {
            tokens.push(Token {
                kind: TokenKind::Verb("\\\\".to_string()),
                start: i,
                end: i + 2,
            });
            i += 2;
            continue;
        }

        if c == '\\' && (i + 1 == bytes.len() || bytes[i + 1] != b':') {
            let mut prev_idx = i;
            while prev_idx > 0 {
                prev_idx -= 1;
                let b = bytes[prev_idx];
                if b != b' ' && b != b'\t' {
                    break;
                }
            }
            let is_verb = if prev_idx == 0 && (bytes[0] == b' ' || bytes[0] == b'\t') {
                true
            } else if prev_idx == 0 {
                bytes[0] == b';' || bytes[0] == b'\n'
            } else {
                let b = bytes[prev_idx];
                b == b';' || b == b'\n'
            };
            if is_verb {
                tokens.push(Token {
                    kind: TokenKind::Verb("\\".to_string()),
                    start: i,
                    end: i + 1,
                });
                i += 1;
                continue;
            }
        }

        if let Some((Word::Adverb(adv_str), consumed)) = parse_adverb(&input[i..]) {
            tokens.push(Token {
                kind: TokenKind::Adverb(adv_str),
                start: i,
                end: i + consumed,
            });
            i += consumed;
            continue;
        }

        if c == '`' {
            if let Some((kdata, consumed)) = parse_symbols(&input[i..])? {
                tokens.push(Token {
                    kind: TokenKind::Noun(K::from(kdata)),
                    start: i,
                    end: i + consumed,
                });
                i += consumed;
                continue;
            } else {
                return Err(KonaError::Parse("Malformed symbol".to_string()));
            }
        }

        if c == '"' {
            if let Some((char_bytes, consumed)) = parse_string_to_bytes(&input[i..])? {
                let noun_k = if char_bytes.len() == 1 {
                    K::char(char_bytes[0] as char)
                } else {
                    K::char_list(char_bytes)
                };
                tokens.push(Token {
                    kind: TokenKind::Noun(noun_k),
                    start: i,
                    end: i + consumed,
                });
                i += consumed;
                continue;
            } else {
                return Err(KonaError::Parse("Unclosed string literal".to_string()));
            }
        }

        // Infix dot-access sugar: x.a -> x . `a
        if c == '.' && i + 1 < bytes.len() && (bytes[i + 1] as char).is_ascii_alphabetic() {
            let has_prev_noun = tokens.last().map_or(false, |t| {
                matches!(t.kind, TokenKind::Name(_) | TokenKind::Noun(_))
            });
            if has_prev_noun {
                tokens.push(Token {
                    kind: TokenKind::Verb(".".to_string()),
                    start: i,
                    end: i + 1,
                });
                i += 1;
                let next_s = &input[i..];
                let mut len = 0;
                while len < next_s.len()
                    && ((next_s.as_bytes()[len] as char).is_ascii_alphanumeric()
                        || next_s.as_bytes()[len] == b'_')
                {
                    len += 1;
                }
                let name = &next_s[..len];
                tokens.push(Token {
                    kind: TokenKind::Noun(K::symbol(name)),
                    start: i,
                    end: i + len,
                });
                i += len;
                continue;
            }
        }

        if c.is_ascii_alphabetic() || c == '.' || c == '_' {
            if let Some((word, consumed)) = parse_name_or_system_verb_token(&input[i..]) {
                match &word {
                    Word::LocalAssign(name) | Word::GlobalAssign(name) if name.starts_with('_') => {
                        return Err(KonaError::Parse("parse".to_string()));
                    }
                    _ => {}
                }
                let kind = match word {
                    Word::Verb(v) => TokenKind::Verb(v),
                    Word::Name(s) => TokenKind::Name(s),
                    Word::Noun(k) => TokenKind::Noun(k),
                    Word::LocalAssign(name) => TokenKind::LocalAssign(name),
                    Word::GlobalAssign(name) => TokenKind::GlobalAssign(name),
                    _ => unreachable!(),
                };
                tokens.push(Token {
                    kind,
                    start: i,
                    end: i + consumed,
                });
                i += consumed;
                continue;
            }
        }

        if is_primitive_verb_char(c) {
            tokens.push(Token {
                kind: TokenKind::Verb(c.to_string()),
                start: i,
                end: i + 1,
            });
            i += 1;
            continue;
        }

        return Err(KonaError::Parse(format!("Unexpected character: '{}'", c)));
    }

    Ok(tokens)
}

struct TokenParser<'a> {
    tokens: &'a [Token],
    pos: usize,
    input: &'a str,
}

impl<'a> TokenParser<'a> {
    fn new(tokens: &'a [Token], input: &'a str) -> Self {
        Self {
            tokens,
            pos: 0,
            input,
        }
    }

    fn is_eof(&self) -> bool {
        self.pos >= self.tokens.len()
    }

    fn peek(&self) -> Option<&Token> {
        self.tokens.get(self.pos)
    }

    fn advance(&mut self) -> Option<&Token> {
        if self.pos < self.tokens.len() {
            let tok = &self.tokens[self.pos];
            self.pos += 1;
            Some(tok)
        } else {
            None
        }
    }

    fn find_matching_brace(&self, start_pos: usize) -> Result<usize, KonaError> {
        let mut depth = 1;
        for i in start_pos..self.tokens.len() {
            match self.tokens[i].kind {
                TokenKind::OpenBrace => depth += 1,
                TokenKind::CloseBrace => {
                    depth -= 1;
                    if depth == 0 {
                        return Ok(i);
                    }
                }
                _ => {}
            }
        }
        Err(KonaError::Parse("Unmatched brace".to_string()))
    }

    fn parse_semicolon_separated(
        &mut self,
        closing: TokenKind,
    ) -> Result<Vec<Vec<Word>>, KonaError> {
        let mut expressions = Vec::new();
        let mut current_expr = Vec::new();

        while !self.is_eof() {
            let tok = self.peek().unwrap();
            if tok.kind == closing {
                self.advance();
                expressions.push(current_expr);
                return Ok(expressions);
            } else if tok.kind == TokenKind::Semicolon {
                self.advance();
                expressions.push(current_expr);
                current_expr = Vec::new();
            } else {
                let word = self.parse_word()?;
                current_expr.push(word);
            }
        }

        Err(KonaError::Parse(format!(
            "Missing closing delimiter {:?}",
            closing
        )))
    }

    fn parse_sequence(&mut self) -> Result<Vec<Word>, KonaError> {
        let mut words = Vec::new();
        while !self.is_eof() {
            if let Some(tok) = self.peek() {
                match tok.kind {
                    TokenKind::CloseParen | TokenKind::CloseBracket | TokenKind::CloseBrace => {
                        break;
                    }
                    _ => {
                        let word = self.parse_word()?;
                        if let Word::Bracket(exprs) = &word {
                            if let Some(Word::Verb(name)) = words.last() {
                                if (name == "@" || name == ".") && exprs.len() < 2 {
                                    return Err(KonaError::Parse(
                                        "Amend/trap expects at least 2 arguments".to_string(),
                                    ));
                                }
                            }
                        }
                        words.push(word);
                    }
                }
            }
        }
        Ok(words)
    }

    fn parse_word(&mut self) -> Result<Word, KonaError> {
        let tok = self
            .advance()
            .ok_or_else(|| KonaError::Parse("Unexpected EOF".to_string()))?;
        match &tok.kind {
            TokenKind::Noun(k) => Ok(Word::Noun(k.clone())),
            TokenKind::Name(s) => Ok(Word::Name(s.clone())),
            TokenKind::Verb(s) => Ok(Word::Verb(s.clone())),
            TokenKind::Adverb(s) => Ok(Word::Adverb(s.clone())),
            TokenKind::LocalAssign(s) => Ok(Word::LocalAssign(s.clone())),
            TokenKind::GlobalAssign(s) => Ok(Word::GlobalAssign(s.clone())),
            TokenKind::Semicolon => Ok(Word::Verb(";".to_string())),
            TokenKind::OpenParen => {
                let exprs = self.parse_semicolon_separated(TokenKind::CloseParen)?;
                Ok(Word::Paren(exprs))
            }
            TokenKind::OpenBracket => {
                let exprs = self.parse_semicolon_separated(TokenKind::CloseBracket)?;
                Ok(Word::Bracket(exprs))
            }
            TokenKind::OpenBrace => {
                let open_brace_pos = self.pos - 1;
                let match_pos = self.find_matching_brace(self.pos)?;

                let body_start = self.tokens[open_brace_pos].end;
                let body_end = self.tokens[match_pos].start;
                let body = self.input[body_start..body_end].to_string();

                let inside_tokens = &self.tokens[self.pos..match_pos];

                let mut args = Vec::new();
                let mut code_tokens = inside_tokens;
                let mut has_explicit_args = false;

                if let Some(first_tok) = inside_tokens.first() {
                    if first_tok.kind == TokenKind::OpenBracket {
                        has_explicit_args = true;
                        let mut depth = 1;
                        let mut close_idx = None;
                        for j in 1..inside_tokens.len() {
                            match inside_tokens[j].kind {
                                TokenKind::OpenBracket => depth += 1,
                                TokenKind::CloseBracket => {
                                    depth -= 1;
                                    if depth == 0 {
                                        close_idx = Some(j);
                                        break;
                                    }
                                }
                                _ => {}
                            }
                        }

                        if let Some(j) = close_idx {
                            let param_tokens = &inside_tokens[1..j];
                            if !param_tokens.is_empty() {
                                let mut expect_name = true;
                                for tok in param_tokens {
                                    match &tok.kind {
                                        TokenKind::Name(name) => {
                                            if !expect_name {
                                                return Err(KonaError::Parse(
                                                    "Invalid parameter list structure".to_string(),
                                                ));
                                            }
                                            args.push(name.clone());
                                            expect_name = false;
                                        }
                                        TokenKind::Semicolon => {
                                            if expect_name {
                                                return Err(KonaError::Parse(
                                                    "Invalid parameter list structure".to_string(),
                                                ));
                                            }
                                            expect_name = true;
                                        }
                                        _ => {
                                            return Err(KonaError::Parse(
                                                "Only names and semicolons allowed in parameter list".to_string(),
                                            ));
                                        }
                                    }
                                }
                                if expect_name {
                                    return Err(KonaError::Parse(
                                        "Trailing semicolon in parameter list".to_string(),
                                    ));
                                }
                            }
                            code_tokens = &inside_tokens[j + 1..];
                        } else {
                            return Err(KonaError::Parse(
                                "Unmatched bracket in function parameters".to_string(),
                            ));
                        }
                    }
                }

                if !has_explicit_args {
                    args = determine_implicit_args(code_tokens);
                }

                validate_function_tokens(code_tokens)?;

                let mut inner_parser = TokenParser::new(code_tokens, self.input);
                let code = inner_parser.parse_sequence()?;

                self.pos = match_pos + 1;

                Ok(Word::Brace { body, args, code })
            }
            TokenKind::CloseParen => {
                Err(KonaError::Parse("Unmatched close parenthesis".to_string()))
            }
            TokenKind::CloseBracket => Err(KonaError::Parse("Unmatched close bracket".to_string())),
            TokenKind::CloseBrace => Err(KonaError::Parse("Unmatched close brace".to_string())),
        }
    }
}

fn determine_implicit_args(tokens: &[Token]) -> Vec<String> {
    let mut _has_x = false;
    let mut has_y = false;
    let mut has_z = false;

    let mut idx = 0;
    while idx < tokens.len() {
        match &tokens[idx].kind {
            TokenKind::OpenBrace => {
                let mut depth = 1;
                idx += 1;
                while idx < tokens.len() {
                    match tokens[idx].kind {
                        TokenKind::OpenBrace => depth += 1,
                        TokenKind::CloseBrace => {
                            depth -= 1;
                            if depth == 0 {
                                break;
                            }
                        }
                        _ => {}
                    }
                    idx += 1;
                }
            }
            TokenKind::Name(name) => {
                if name == "x" {
                    _has_x = true;
                } else if name == "y" {
                    has_y = true;
                } else if name == "z" {
                    has_z = true;
                }
            }
            _ => {}
        }
        idx += 1;
    }

    if has_z {
        vec!["x".to_string(), "y".to_string(), "z".to_string()]
    } else if has_y {
        vec!["x".to_string(), "y".to_string()]
    } else {
        vec!["x".to_string()]
    }
}

fn combine_monadic_verbs(tokens: Vec<Token>) -> Vec<Token> {
    let mut merged = Vec::with_capacity(tokens.len());
    let mut i = 0;
    while i < tokens.len() {
        if i + 1 < tokens.len() {
            if let TokenKind::Verb(v1) = &tokens[i].kind {
                if let TokenKind::Verb(v2) = &tokens[i + 1].kind {
                    if v2 == ":" && tokens[i].end == tokens[i + 1].start {
                        let next_is_bracket = if i + 2 < tokens.len() {
                            matches!(tokens[i + 2].kind, TokenKind::OpenBracket)
                        } else {
                            false
                        };
                        if !next_is_bracket {
                            let combined_kind = TokenKind::Verb(format!("{}:", v1));
                            merged.push(Token {
                                kind: combined_kind,
                                start: tokens[i].start,
                                end: tokens[i + 1].end,
                            });
                            i += 2;
                            continue;
                        }
                    }
                }
            }
        }
        merged.push(tokens[i].clone());
        i += 1;
    }
    merged
}

pub fn parse(input: &str) -> Result<Vec<Word>, KonaError> {
    if has_invalid_colon_suffix(input) {
        return Err(KonaError::Parse("parse".to_string()));
    }
    let tokens = tokenize(input)?;
    let tokens = combine_monadic_verbs(tokens);
    let mut parser = TokenParser::new(&tokens, input);
    let result = parser.parse_sequence()?;
    if !parser.is_eof() {
        return Err(KonaError::Parse("Unexpected tokens remaining".to_string()));
    }
    Ok(result)
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn test_verbs() {
        let ast = parse("+").unwrap();
        assert_eq!(ast, vec![Word::Verb("+".to_string())]);

        let ast = parse("0:").unwrap();
        assert_eq!(ast, vec![Word::Verb("0:".to_string())]);

        let ast = parse("_abs").unwrap();
        assert_eq!(ast, vec![Word::Verb("_abs".to_string())]);

        let ast = parse("_t").unwrap();
        assert_eq!(ast, vec![Word::Name("_t".to_string())]);

        let ast = parse("::").unwrap();
        assert_eq!(ast, vec![Word::Verb("::".to_string())]);

        let ast = parse("::::").unwrap();
        assert_eq!(ast, vec![Word::Verb("::::".to_string())]);

        assert!(matches!(parse(":::"), Err(KonaError::Parse(_))));
        assert!(matches!(parse("4:::"), Err(KonaError::Parse(_))));
        assert!(matches!(parse("a _abs: "), Err(KonaError::Parse(_))));
    }

    #[test]
    fn test_negatives() {
        let ast = parse("-1").unwrap();
        assert_eq!(ast, vec![Word::Noun(K::int(-1))]);

        let ast = parse("1-2").unwrap();
        assert_eq!(
            ast,
            vec![
                Word::Noun(K::int(1)),
                Word::Verb("-".to_string()),
                Word::Noun(K::int(2))
            ]
        );

        let ast = parse("1 -2").unwrap();
        assert_eq!(ast, vec![Word::Noun(K::int_list(vec![1, -2]))]);

        let ast = parse("x-2").unwrap();
        assert_eq!(
            ast,
            vec![
                Word::Name("x".to_string()),
                Word::Verb("-".to_string()),
                Word::Noun(K::int(2))
            ]
        );

        let ast = parse("(1 2)-3").unwrap();
        assert_eq!(
            ast,
            vec![
                Word::Paren(vec![vec![Word::Noun(K::int_list(vec![1, 2]))]]),
                Word::Verb("-".to_string()),
                Word::Noun(K::int(3))
            ]
        );
    }

    #[test]
    fn test_numeric_vectors() {
        let ast = parse("1 2 3").unwrap();
        assert_eq!(ast, vec![Word::Noun(K::int_list(vec![1, 2, 3]))]);

        let ast = parse("1.5 -2.4 3").unwrap();
        assert_eq!(ast, vec![Word::Noun(K::float_list(vec![1.5, -2.4, 3.0]))]);
    }

    #[test]
    fn test_symbols() {
        let ast = parse("`a").unwrap();
        assert_eq!(ast, vec![Word::Noun(K::symbol("a"))]);

        let ast = parse("`a`b").unwrap();
        assert_eq!(
            ast,
            vec![Word::Noun(K::symbol_list(vec![
                Arc::from("a"),
                Arc::from("b")
            ]))]
        );

        let ast = parse("`\"hello\"").unwrap();
        assert_eq!(ast, vec![Word::Noun(K::symbol("hello"))]);

        let ast = parse("`\"hello\"`world").unwrap();
        assert_eq!(
            ast,
            vec![Word::Noun(K::symbol_list(vec![
                Arc::from("hello"),
                Arc::from("world")
            ]))]
        );

        let ast = parse("`0:").unwrap();
        assert_eq!(
            ast,
            vec![Word::Noun(K::symbol("")), Word::Verb("0:".to_string())]
        );

        let ast = parse("`a0:").unwrap();
        assert_eq!(
            ast,
            vec![Word::Noun(K::symbol("a")), Word::Verb("0:".to_string())]
        );

        let ast = parse("`a0").unwrap();
        assert_eq!(ast, vec![Word::Noun(K::symbol("a0"))]);
    }

    #[test]
    fn test_strings() {
        let ast = parse("\"abc\\n123\"").unwrap();
        assert_eq!(ast, vec![Word::Noun(K::char_list(b"abc\n123".to_vec()))]);

        let ast = parse("\"\\101\\102\"").unwrap();
        assert_eq!(ast, vec![Word::Noun(K::char_list(b"AB".to_vec()))]);
    }

    #[test]
    fn test_assignments() {
        let ast = parse("x: 1").unwrap();
        assert_eq!(
            ast,
            vec![Word::LocalAssign("x".to_string()), Word::Noun(K::int(1))]
        );

        let ast = parse("y::2").unwrap();
        assert_eq!(
            ast,
            vec![Word::GlobalAssign("y".to_string()), Word::Noun(K::int(2))]
        );
    }

    #[test]
    fn test_enclosures() {
        let ast = parse("(1;2;3)").unwrap();
        assert_eq!(
            ast,
            vec![Word::Paren(vec![
                vec![Word::Noun(K::int(1))],
                vec![Word::Noun(K::int(2))],
                vec![Word::Noun(K::int(3))],
            ])]
        );

        let ast = parse("{x+y}").unwrap();
        assert_eq!(
            ast,
            vec![Word::Brace {
                body: "x+y".to_string(),
                args: vec!["x".to_string(), "y".to_string()],
                code: vec![
                    Word::Name("x".to_string()),
                    Word::Verb("+".to_string()),
                    Word::Name("y".to_string()),
                ]
            }]
        );

        let ast = parse("{[a;b] a+b}").unwrap();
        assert_eq!(
            ast,
            vec![Word::Brace {
                body: "[a;b] a+b".to_string(),
                args: vec!["a".to_string(), "b".to_string()],
                code: vec![
                    Word::Name("a".to_string()),
                    Word::Verb("+".to_string()),
                    Word::Name("b".to_string()),
                ]
            }]
        );

        let ast = parse("{[] 1}").unwrap();
        assert_eq!(
            ast,
            vec![Word::Brace {
                body: "[] 1".to_string(),
                args: vec![],
                code: vec![Word::Noun(K::int(1))]
            }]
        );

        let ast = parse("{[]}").unwrap();
        assert_eq!(
            ast,
            vec![Word::Brace {
                body: "[]".to_string(),
                args: vec![],
                code: vec![]
            }]
        );

        assert!(parse("{[a + b] 1}").is_err());
        assert!(parse("{[a;] 1}").is_err());
        assert!(parse("{[a;;b] 1}").is_err());
        assert!(parse("{[;a] 1}").is_err());
        assert!(parse("{[a b] 1}").is_err());
    }

    #[test]
    fn test_invalid_system_identifier() {
        let res = parse("{_vs.a[x]}");
        println!("RES: {:?}", res);
        assert!(res.is_err());
    }
}
